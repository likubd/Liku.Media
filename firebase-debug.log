[debug] [2026-10-14T04:25:54.379Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/likumediabd/rulesets {"name":"projects/likumediabd/rulesets/c664ba12-68a8-4340-b159-e4fa390d278f","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    \n    match /users/{phoneId} {\n      // Allow read access for credentials check\n      allow read: if true;\n      \n      // Allow creation with strict validation\n      allow create: if \n        phoneId == request.resource.data.phone &&\n        request.resource.data.name is string &&\n        request.resource.data.name.size() > 0 &&\n        request.resource.data.name.size() < 100 &&\n        request.resource.data.pin is string &&\n        request.resource.data.pin.size() == 6 &&\n        request.resource.data.role is string &&\n        request.resource.data.role in ['super_admin', 'admin', 'manager', 'client'] &&\n        (\n          (request.resource.data.role == 'super_admin' && phoneId == '+880 1850290529' && request.resource.data.pin == '199800') ||\n          (request.resource.data.role != 'super_admin' && phoneId != '+880 1850290529')\n        );\n        \n      // Allow updates with strict validation (preventing privilege escalation)\n      allow update: if\n        request.resource.data.phone == resource.data.phone &&\n        request.resource.data.name is string &&\n        request.resource.data.name.size() > 0 &&\n        request.resource.data.name.size() < 100 &&\n        request.resource.data.pin is string &&\n        request.resource.data.pin.size() == 6 &&\n        request.resource.data.role is string &&\n        request.resource.data.role in ['super_admin', 'admin', 'manager', 'client'] &&\n        (\n          (request.resource.data.role == resource.data.role) || \n          (resource.data.role == 'super_admin') \n        );\n\n      // Allow deletion only if not deleting the main Super Admin account\n      allow delete: if phoneId != '+880 1850290529';\n    }\n\n    match /messages/{messageId} {\n      // Allow public creation of contact messages\n      allow create: if true;\n      \n      // Allow read and deletion for dashboard administration\n      allow read, delete: if true;\n    }\n\n    // SMS Gateway Collections\n    match /sms_websites/{websiteId} {\n      allow read, write: if true;\n    }\n\n    match /sms_logs/{logId} {\n      allow read, write: if true;\n    }\n\n    match /sms_settings/{settingId} {\n      allow read, write: if true;\n    }\n\n    // Invoices Collection\n    match /invoices/{invoiceId} {\n      allow read, write: if true;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-10-14T04:25:54.217711Z","metadata":{"services":["cloud.firestore"]}}
